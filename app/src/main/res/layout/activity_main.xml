<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT: activity_main.xml

    ConstraintLayout como contentor raiz:
    Permite hierarquias de vistas planas (sem aninhamento excessivo),
    o que reduz o número de passes de medição/layout do sistema de renderização.
    É o layout recomendado pela Google para interfaces responsivas em qualquer
    densidade de ecrã — de 4" a tablets de 12".

    android:padding="16dp": margem interna de 16dp conforme Material Design baseline grid.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.MainActivity">

    <!-- Campo: Estado Emocional -->
    <EditText
        android:id="@+id/editTextEstado"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Como se sente hoje?"
        android:inputType="textPersonName"
        android:contentDescription="Campo de estado emocional"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Campo: Notas do Diário (multilinha) -->
    <EditText
        android:id="@+id/editTextNotas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Escreva as suas notas aqui..."
        android:inputType="textMultiLine"
        android:gravity="top"
        android:lines="3"
        android:contentDescription="Campo de notas do diário"
        app:layout_constraintTop_toBottomOf="@id/editTextEstado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!--
        BOTÃO GUARDAR — Metade esquerda da corrente horizontal.

        android:layout_width="0dp" (MATCH_CONSTRAINT):
        No ConstraintLayout, 0dp significa "ocupa o espaço definido pelas restrições",
        não "tamanho zero". O Android calcula a largura dividindo o espaço disponível
        pelos dois botões da corrente — comportamento responsivo automático.

        app:layout_constraintHorizontal_chainStyle="spread":
        Define a distribuição da corrente. "spread" divide o espaço igualmente.
        Alternativas: "packed" (agrupa os botões ao centro) e "spread_inside"
        (fixa nas extremidades e distribui os restantes).
    -->
    <Button
        android:id="@+id/buttonGuardar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guardar"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/editTextNotas"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/buttonLimpar"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <!-- BOTÃO LIMPAR — Metade direita da corrente horizontal. -->
    <Button
        android:id="@+id/buttonLimpar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Limpar"
        android:layout_marginTop="12dp"
        android:layout_marginStart="4dp"
        android:backgroundTint="#FF5722"
        app:layout_constraintTop_toBottomOf="@id/editTextNotas"
        app:layout_constraintStart_toEndOf="@id/buttonGuardar"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
        RECYCLERVIEW — Ocupa o espaço restante do ecrã.

        android:layout_height="0dp" com constraintTop e constraintBottom:
        O RecyclerView expande-se para preencher toda a área entre os botões
        e o fundo do ecrã — comportamento correto em qualquer tamanho de dispositivo.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRegistos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/buttonGuardar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
