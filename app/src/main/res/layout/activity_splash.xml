<?xml version="1.0" encoding="utf-8"?>
<!--
    LAYOUT: activity_splash.xml
    Ecrã de arranque — design simples, centrado, com nome da aplicação.
    Background: cor primária definida no tema. Pode ser substituído por uma imagem.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- Nome da Aplicação centrado no ecrã -->
    <TextView
        android:id="@+id/textViewNomeApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Diário de Emoções"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/textViewSubtitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtítulo / tagline -->
    <TextView
        android:id="@+id/textViewSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regista. Reflete. Cresce."
        android:textSize="14sp"
        android:textColor="#B0BEC5"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textViewNomeApp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
